{
  "framework": "nextjs",
  "buildCommand": "cd ../.. && npm run build --workspace=apps/web",
  "outputDirectory": "apps/web/.next",
  "installCommand": "npm install",
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.servitron.id",
    "NEXT_PUBLIC_SITE_URL": "https://servitron.id"
  },
  "rewrites": [
    { "source": "/download/:uuid", "destination": "https://api.servitron.id/download/resolve?uuid=:uuid" },
    { "source": "/go/:id", "destination": "https://api.servitron.id/affiliate/:id" }
  ],
  "headers": [
    {
      "source": "/firmware/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=3600, stale-while-revalidate=86400" }]
    }
  ]
}